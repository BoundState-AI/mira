# Frontend auth configuration (Vite)
VITE_COGNITO_USER_POOL_ID=us-gov-west-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_HOSTED_UI_DOMAIN=mira-auth.auth-fips.us-gov-west-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://mira.boundstate.ai/auth/callback
VITE_COGNITO_LOGOUT_URI=https://mira.boundstate.ai/
VITE_COGNITO_OAUTH_SCOPES=openid email aws.cognito.signin.user.admin

# Optional: set when using a Cognito federated IdP for NASA/MAPTIS PIV
# Example: VITE_COGNITO_IDENTITY_PROVIDER=NASA_MAPTIS_PIV
# Optional button label override
# VITE_COGNITO_FEDERATED_BUTTON_LABEL=Sign in with NASA PIV
# Optional: force PIV/federated-only login on the frontend
# VITE_COGNITO_PASSWORD_LOGIN_DISABLED=true

# Optional: mirror backend allowlists for better UX in the app shell
# VITE_MIRA_ALLOWED_GROUPS=mira-user,mira-admin,mira-itar
# VITE_MIRA_ALLOWED_USERNAMES=
# VITE_MIRA_ALLOWED_EMAILS=

# Hosts where Authorization header should be attached (comma-separated host:port)
VITE_API_AUTH_HOSTS=127.0.0.1:8000,localhost:8000,mira.boundstate.ai

# Local dev only: bypass frontend login/route auth (ignored in production builds)
# VITE_AUTH_BYPASS_LOCAL=true
