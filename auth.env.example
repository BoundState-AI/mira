# Backend auth configuration (copy values into your deployment env)
MIRA_AUTH_MODE=cognito
COGNITO_REGION=us-gov-west-1
COGNITO_USER_POOL_ID=us-gov-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Authorization path controls (comma-separated prefixes)
ITAR_PATH_PREFIXES=/miul,/bom
ADMIN_PATH_PREFIXES=/admin

# Optional approved-user enforcement for federated PIV or enterprise SSO.
# Authenticated users must match at least one configured group, username, or email.
# Keep mira-admin in the approved set or map admins into that group upstream.
# MIRA_ALLOWED_GROUPS=mira-user,mira-admin,mira-itar
# MIRA_ALLOWED_USERNAMES=
# MIRA_ALLOWED_EMAILS=

# Audit logging
AUDIT_LOG_GROUP=/mira/audit
AUDIT_LOG_STREAM_PREFIX=mira-auth
AUDIT_LOG_RETENTION_DAYS=1827
ENABLE_AUDIT_LOGGING=true

# Optional CORS
COGNITO_HOSTED_UI_ORIGIN=https://mira-auth.auth-fips.us-gov-west-1.amazoncognito.com
CORS_EXTRA_ORIGINS=https://mira.boundstate.ai
