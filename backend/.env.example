# BoundState MIRA Backend - Environment Variables
# Copy this to .env and fill in values

# Anthropic API key (required for MIUL extraction and AI features)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# PostgreSQL connection string (optional - for Knowledge Twins hybrid search)
# DATABASE_URL=postgresql://user:password@localhost:5432/mira

# Server port (default 8000 for local dev, set by Railway in production)
# PORT=8000
